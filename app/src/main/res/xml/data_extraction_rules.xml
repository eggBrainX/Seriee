<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-transfer rules.
  Keys are excluded from both paths; everything else (library, streak, theme)
  may be restored by the system.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="seriee_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="seriee_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
