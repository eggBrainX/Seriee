    <!-- Changelog -->
    <string name="changelog_title">What\'s New</string>
    <string name="changelog_version">Version %1$s</string>
    <string name="changelog_got_it">Got it</string>
    <string name="changelog_close">Close changelog</string>
    <string name="changelog_1">Multi-season support — one title can now hold Season 1, 2, and more, with separate episode counts and progress</string>
    <string name="changelog_2">Episode picker — tap a season and an episode number (E1, E2…) to play it instantly in VLC / MX Player, just like their in-app pickers</string>
    <string name="changelog_3">Offline files per episode — pick a whole folder or multiple files; filenames like S02E05 are matched automatically, and you can still fix each episode manually</string>
    <string name="changelog_4">Poster upload — choose a cover from your device storage (saved inside the app) or keep using a URL</string>
    <string name="changelog_5">Auto-fetch info — search AniList (anime, no key needed) and TMDB (optional key in Backup settings) to fill title, poster, description, genres, and streaming links — all still editable</string>
    <string name="changelog_6">Descriptions — fetched and manual descriptions now show on the details screen</string>
    <string name="changelog_7">Indonesian + English labels for all the new features</string>

