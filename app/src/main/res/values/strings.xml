    <!-- Changelog -->
    <string name="changelog_title">What\'s New</string>
    <string name="changelog_version">Version %1$s</string>
    <string name="changelog_got_it">Got it</string>
    <string name="changelog_close">Close changelog</string>
    <string name="changelog_15">Seven themes in a new two-level menu — Follow system, Dark, AMOLED, Frost Glass, Liquid Glass, Light, and a Custom theme with your own accent and solid or gradient background</string>
    <string name="changelog_16">On Hold and Dropped are now real statuses, so you can filter and colour-code paused and abandoned titles everywhere</string>
    <string name="changelog_17">Swipe left or right to move between Progress and Library, with a floating navigation pill that follows your drag</string>
    <string name="changelog_18">Import your collection from AniList or a MyAnimeList export, preview the result, and choose merge (never lowers progress) or replace</string>
    <string name="changelog_19">Redesigned header, filled search pill, gradient progress bars, and detail, edit, and backup screens that open as bottom sheets</string>
    <string name="changelog_20">System default language option, plus localised import errors and empty states</string>
    <string name="changelog_21">Fixed: the FAB hides while scrolling, and Progress and Library swipes no longer fight the filter chips</string>
    <string name="changelog_22">Themes now have two independent axes: appearance (Follow system, Light, Dark) and style (Classic, AMOLED, Frost Glass, Liquid Glass, Material You, Custom)</string>
    <string name="changelog_23">Every style ships both a light and a dark variant, so Frost Glass and Liquid Glass work in daylight too</string>
    <string name="changelog_24">New Material You style follows your wallpaper palette on Android 12 and newer</string>
    <string name="changelog_25">Custom theme: pick any two-stop gradient, grab an accent from a poster’s artwork, and copy or paste a theme code to share it</string>
    <string name="changelog_26">New Reduce transparency switch, plus an optional AMOLED mode that turns on with battery saver</string>
    <string name="changelog_27">Dialogs, text fields, switches and gradients now all follow the active palette, with a complete Material 3 colour scheme</string>
    <string name="changelog_28">Fixed: light themes no longer flash a dark window while the app starts</string>
    <string name="changelog_29">A new Insights tab shows episodes watched, estimated watch time, completion rate, and average rating at a glance</string>
    <string name="changelog_30">Status breakdown, star ratings, and top genres come as accessible, theme-aware charts</string>
    <string name="changelog_31">A 12-week activity heatmap and a recent watch timeline, including titles you have since deleted</string>
    <string name="changelog_32">Watch history is logged automatically when you advance or jump episodes, and backups now use format version 4 with history included</string>
    <string name="changelog_33">Clear watch history from Insights without touching your library, progress, or streak</string>

    <!-- Current release, in display order. The What's New dialog and the
         release-notes generator in .github/workflows/build-apk.yml both read
         this list, so shipping a version only means adding its changelog_*
         strings and listing them here. Never renumber existing changelog_N
         entries: the numbering is monotonic across releases. -->
    <string-array name="changelog_current">
        <item>@string/changelog_29</item>
        <item>@string/changelog_30</item>
        <item>@string/changelog_31</item>
        <item>@string/changelog_32</item>
        <item>@string/changelog_33</item>
    </string-array>

