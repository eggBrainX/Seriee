    <!-- Changelog -->
    <string name="changelog_title">What\'s New</string>
    <string name="changelog_version">Version %1$s</string>
    <string name="changelog_got_it">Got it</string>
    <string name="changelog_close">Close changelog</string>
    <string name="changelog_1">Coming Soon now uses real air dates from AniList and TMDB, so the countdown matches the source instead of a placeholder date</string>
    <string name="changelog_2">Movies now show Watched / Not watched instead of the confusing "Episode 1 / 1" label</string>
    <string name="changelog_3">Duplicate guard — saving a title that is already in your library (same title, type, and season) is now blocked with a clear message</string>
    <string name="changelog_4">Library grid — adaptive columns, real 2:3 poster shape, two-line titles, and up to two tags with a +N counter</string>
    <string name="changelog_5">Library list — 2:3 thumbnails, two-line titles, and a single-line metadata row that no longer overflows</string>
    <string name="changelog_6">One rating badge per item — the duplicate star badge next to long titles is gone, giving titles more room</string>
    <string name="changelog_7">Daily streak — watch an episode every day to build your streak, with a flame badge, week strip, and best streak in Progress</string>
    <string name="changelog_8">TVMaze search (free, no key) — precise next-episode airtimes for Western TV, backing up the Coming Soon countdown alongside AniList and TMDB</string>
    <string name="changelog_9">OMDb search (optional key in Backup settings) — IMDb-powered movies and series as another source alongside AniList, TVMaze, and TMDB</string>
    <string name="changelog_10">Seriee is now Apache-2.0 licensed — the source, build files, and release process are open for reuse, with TMDB, JustWatch, AniList, TVmaze, and OMDb credits in the new About screen</string>
    <string name="changelog_11">API keys moved to an isolated preferences file that Android never backs up, and cleartext HTTP is now blocked app-wide</string>
    <string name="changelog_12">Release builds are minified with R8 and published with a SHA-256 checksum; unsigned debug APKs are no longer distributed to users</string>
    <string name="changelog_13">Targets Android 16 (API 36) with modern backup and network-security rules</string>
    <string name="changelog_14">Application ID changed to com.seriee.app — export a backup before installing this build, because Android treats it as a new app</string>
    <string name="changelog_15">Seven themes in a new two-level menu — Follow system, Dark, AMOLED, Frost Glass, Liquid Glass, Light, and a Custom theme with your own accent and solid or gradient background</string>
    <string name="changelog_16">On Hold and Dropped are now real statuses, so you can filter and colour-code paused and abandoned titles everywhere</string>
    <string name="changelog_17">Swipe left or right to move between Progress and Library, with a floating navigation pill that follows your drag</string>
    <string name="changelog_18">Import your collection from AniList or a MyAnimeList export, preview the result, and choose merge (never lowers progress) or replace</string>
    <string name="changelog_19">Redesigned header, filled search pill, gradient progress bars, and detail, edit, and backup screens that open as bottom sheets</string>
    <string name="changelog_20">System default language option, plus localised import errors and empty states</string>
    <string name="changelog_21">Fixed: the FAB hides while scrolling, and Progress and Library swipes no longer fight the filter chips</string>

