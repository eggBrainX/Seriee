    <!-- About / credits -->
    <string name="about_title">About Seriee</string>
    <string name="about_tagline">A local-first watch-progress tracker for series, anime, and movies.</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_data_sources">Data sources &amp; credits</string>
    <string name="about_tmdb_notice">This product uses the TMDB API but is not endorsed or certified by TMDB.</string>
    <string name="about_justwatch_notice">Watch-provider data is provided by JustWatch.</string>
    <string name="about_other_sources">Anime metadata from AniList, TV schedules from TVmaze, and additional movie/TV details from OMDb (IMDb data). Collection import supports public AniList lists and MyAnimeList XML exports. Posters and metadata remain the property of their respective rights holders.</string>
    <string name="about_privacy">Privacy</string>
    <string name="about_privacy_body">Seriee stores your library only on this device. A metadata search sends the title you type to the selected providers (AniList, TVmaze, TMDB, OMDb); an AniList import sends only the username you type. MyAnimeList exports are parsed on-device. No analytics, ads, or accounts. API keys stay on-device and are excluded from system backups.</string>
    <string name="about_privacy_link">Read the privacy policy</string>
    <string name="about_license">License</string>
    <string name="about_license_value">Apache License 2.0</string>
    <string name="about_license_link">Read the license</string>
    <string name="about_third_party_link">Third-party notices</string>
    <string name="about_source">Source code on GitHub</string>
    <string name="about_disclaimer">Seriee is not affiliated with Netflix, Bilibili, YouTube, TMDB, or any other streaming service. It does not host or provide copyrighted content; playback links point to services you already use.</string>
