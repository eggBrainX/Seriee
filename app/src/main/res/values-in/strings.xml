    <!-- Changelog -->
    <string name="changelog_title">Yang Baru</string>
    <string name="changelog_version">Versi %1$s</string>
    <string name="changelog_got_it">Mengerti</string>
    <string name="changelog_close">Tutup changelog</string>
    <string name="changelog_1">Segera Tayang kini memakai tanggal rilis asli dari AniList dan TMDB, jadi hitung mundurnya sesuai sumber, bukan tanggal perkiraan</string>
    <string name="changelog_2">Film kini menampilkan Sudah ditonton / Belum ditonton, bukan label "Episode 1 / 1" yang membingungkan</string>
    <string name="changelog_3">Pencegahan duplikat — menyimpan judul yang sudah ada di pustaka (judul, tipe, dan musim sama) kini diblokir dengan pesan yang jelas</string>
    <string name="changelog_4">Grid Pustaka — kolom adaptif, poster 2:3 yang proporsional, judul dua baris, dan maksimal dua tag plus penghitung +N</string>
    <string name="changelog_5">Daftar Pustaka — thumbnail 2:3, judul dua baris, dan baris info satu baris yang tidak lagi terpotong</string>
    <string name="changelog_6">Satu badge rating per item — badge bintang ganda di samping judul panjang dihapus, memberi ruang lebih untuk judul</string>
    <string name="changelog_7">Streak harian — tonton satu episode setiap hari untuk membangun streak, dengan badge api, strip minggu, dan streak terbaik di Progres</string>
    <string name="changelog_8">Pencarian TVMaze (gratis, tanpa kunci) — jadwal tayang episode berikutnya yang akurat untuk TV Barat, melengkapi hitung mundur Segera Tayang bersama AniList dan TMDB</string>
    <string name="changelog_9">Pencarian OMDb (kunci opsional di Pengaturan Cadangan) — film dan serial berbasis IMDb sebagai sumber lain bersama AniList, TVMaze, dan TMDB</string>

